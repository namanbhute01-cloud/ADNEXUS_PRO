generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String
  name         String
  role         Role                 @default(CAMPAIGNER)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  campaigns    Campaign[]
  evAccess     CampaignerEVAccess[]
  media        Media[]
  sessions     UserSession[]
}

model EV {
  id               String               @id @default(cuid())
  serialNumber     String               @unique
  locationName     String
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  campaignerAccess CampaignerEVAccess[]
  tvs              TV[]
}

model TV {
  id          String             @id @default(cuid())
  evId        String
  subSerial   String             @unique
  screenIndex Int
  createdAt   DateTime           @default(now())
  assignments ScreenAssignment[]
  ev          EV                 @relation(fields: [evId], references: [id])
  heartbeats  TVHeartbeat[]
}

model CampaignerEVAccess {
  id     String @id @default(cuid())
  userId String
  evId   String
  ev     EV     @relation(fields: [evId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, evId])
}

model Media {
  id            String          @id @default(cuid())
  userId        String
  filename      String
  originalName  String
  r2Key         String          @unique
  url           String
  type          MediaType
  duration      Int?
  sizeBytes     Int
  status        MediaStatus     @default(PROCESSING)
  createdAt     DateTime        @default(now())
  campaignMedia CampaignMedia[]
  user          User            @relation(fields: [userId], references: [id])
}

model Campaign {
  id          String             @id @default(cuid())
  userId      String
  name        String
  status      CampaignStatus     @default(DRAFT)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  user        User               @relation(fields: [userId], references: [id])
  media       CampaignMedia[]
  assignments ScreenAssignment[]
}

model CampaignMedia {
  id            String        @id @default(cuid())
  campaignId    String
  mediaId       String
  order         Int
  displayTime   Int           @default(10)
  duckAmbient   Boolean       @default(true)
  loopPlayback  Boolean       @default(false)
  playbackLayer PlaybackLayer @default(PRIMARY)
  volumePercent Int           @default(100)
  campaign      Campaign      @relation(fields: [campaignId], references: [id])
  media         Media         @relation(fields: [mediaId], references: [id])

  @@unique([campaignId, mediaId])
  @@index([campaignId, order])
}

model ScreenAssignment {
  id           String       @id @default(cuid())
  tvId         String
  campaignId   String
  scheduleType ScheduleType @default(CONTINUOUS)
  startTime    DateTime?
  endTime      DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  campaign     Campaign     @relation(fields: [campaignId], references: [id])
  tv           TV           @relation(fields: [tvId], references: [id])
}

model TVHeartbeat {
  id        String   @id @default(cuid())
  tvId      String
  ip        String?
  timestamp DateTime @default(now())
  tv        TV       @relation(fields: [tvId], references: [id])
}

model UserSession {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now())
}

enum Role {
  ADMIN
  CAMPAIGNER
}

enum MediaType {
  VIDEO
  IMAGE
  AUDIO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PlaybackLayer {
  PRIMARY
  AMBIENT
}

enum ScheduleType {
  CONTINUOUS
  SINGLE
  SCHEDULED
}
