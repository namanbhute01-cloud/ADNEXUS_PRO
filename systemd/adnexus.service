[Unit]
Description=AdNexus CMS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=naman
Group=naman
WorkingDirectory=/home/naman/adnexus2.0/Adnexus2/apps/web
EnvironmentFile=-/home/naman/adnexus2.0/Adnexus2/apps/web/.env.runtime
Environment=NODE_ENV=production
ExecStart=/home/naman/adnexus2.0/Adnexus2/start.sh
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
